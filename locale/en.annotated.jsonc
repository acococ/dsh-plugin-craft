{
  // ==========================================================================
  // locale/en.json —— 英文文案（逐行注释版）
  // ----------------------------------------------------------------------------
  // 【为什么是另存的一份】
  // 文案文件是**运行时数据**，宿主用严格的 JSON.parse 读它。
  // 加 // 注释进去，i18n 直接读不出来。
  //
  // 所以真正的 locale/en.json 保持原样；
  // 这份 locale/en.annotated.jsonc 是给人读的注释版。改文案请改 en.json。
  //
  // 匹配规则：键名和 zh.json 完全一致，宿主按当前语言选一份。
  // 加新文案时要**两个语言文件同时加**，只加一边会退化成显示另一种语言。
  // ==========================================================================

  // 侧边栏/面板的入口标签 —— 短，用于导航项。
  "panel": "Workshop",

  // 面板主标题 —— 长，用于页面顶部大标题。
  "title": "Plugin Workshop",

  // 「新建项目」按钮的文字。
  "createButton": "New Project",

  // 空状态提示：一个项目都没有时显示在列表位置。
  "empty": "No plugin projects yet"
}
