{
  // ==========================================================================
  // tsconfig.json —— 只做类型检查，不产出代码
  // --------------------------------------------------------------------------
  // 真正的构建是 tsdown 的活（见 tsdown.config.mjs）。
  // tsc 在这里只负责证明「源码和测试能通过类型检查」，
  // 这就是 `pnpm typecheck` 在发版前跑的东西。
  //
  // 注意：TypeScript 是把这个文件当 JSONC 解析的，所以下面这些注释都是合法的，
  // 不会影响 tsc 读取配置。
  // ==========================================================================
  "compilerOptions": {

    // ------------------------------------------------------------------
    // 语言与模块目标
    // ------------------------------------------------------------------
    // 编译到 Node 22 的语法级别，和 package.json 里的 engines 范围、
    // 以及宿主实际的运行时保持一致。
    "target": "ES2022",

    // 只用 ESM —— package.json 声明了 "type": "module"。
    "module": "ESNext",

    // 打包器解析模式。
    // 选它而不是 node16：这样不带扩展名的相对路径 import 能正常解析，
    // 同时像 "./types.js" 这种显式写 .js 的写法也能对上 types.ts。
    "moduleResolution": "Bundler",

    // 标准库类型集合。
    // 带上 DOM 只是为了覆盖宿主那些面向客户端的契约类型；
    // store 自己一个浏览器 API 都没用。
    "lib": ["ES2022", "DOM"],

    // 只加载 node 的全局类型（Buffer、process、node:fs 那些声明）。
    "types": ["node"],

    // JSX 保留不转换。本项目没有 .tsx，纯粹是占位避免被后续工具报错。
    "jsx": "preserve",

    // ------------------------------------------------------------------
    // 严格性
    // ------------------------------------------------------------------
    // 打开严格模式全家桶。
    // 为什么这么在意：store 会对每一道信任边界做运行时校验
    // （来自模型的插件名、从磁盘读回来的 JSON），
    // 编译期也必须一样挑剔。
    "strict": true,

    // 禁止隐式 any。
    "noImplicitAny": true,

    // 跳过依赖包的 .d.ts 检查。
    // 宿主自己那些类型定义不是我们能修的，
    // 不跳过的话会因为跟本项目无关的类型问题导致检查失败。
    "skipLibCheck": true,

    // ------------------------------------------------------------------
    // 模块规范
    // ------------------------------------------------------------------
    // 强制「纯类型用途必须写 import type」。
    // 作用：保证最终 ESM 产物里不会带上一条只是为了类型而存在的值 import。
    "verbatimModuleSyntax": true,

    // 每个文件都是独立模块。
    // 作用：不依赖 tsdown，独立地强制上面那条 import type 纪律。
    "isolatedModules": true,

    // 即使文件里没有 import/export，也强制按模块处理。
    "moduleDetection": "force",

    // ------------------------------------------------------------------
    // 输出
    // ------------------------------------------------------------------
    // 只检查、不产出。emit 的活全部交给 tsdown。
    "noEmit": true
  },

  // ==========================================================================
  // include：类型检查要覆盖哪些文件
  // ==========================================================================
  // 包含 src（要发布的源码）和 tests（测试代码也要过类型检查）。
  // 刻意排除 lib/（构建产物，会造成循环）和 dsh-plugin-guide/（外部知识库）。
  "include": ["src", "tests"]
}
