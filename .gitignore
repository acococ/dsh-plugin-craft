# ============================================================
#  dsh-plugin-craft — standard DSH plugin .gitignore
#  Source: https://github.com/acococ/dsh-plugin-craft
# ============================================================

# Dependencies (re-installed by `pnpm install`)
node_modules/
.pnpm-store/

# Build artifacts (re-generated by `pnpm run build`)
lib/
*.tsbuildinfo

# Packed tarballs (re-generated by `pnpm pack`)
*.tgz

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local environment overrides
.env
.env.*.local

# Tooling caches
.cache/