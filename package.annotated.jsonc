{
  // ==========================================================================
  // package.json —— 逐行注释版
  // ----------------------------------------------------------------------------
  // 【为什么是另存的一份】
  // package.json 是**运行时配置文件**，pnpm / npm / Node 都用严格的 JSON.parse
  // 解析它。加一行 // 注释进去，整个包就装不上、构建就跑不起来。
  // 所以真正的 package.json 保持原样；这份是给人读的注释版。
  // 改配置请改 package.json，不要改这个文件。
  //
  // ==========================================================================
  // 【字段分类图例】
  // ----------------------------------------------------------------------------
  // [固定] npm/Node 标准字段。名字和语义都是工具链定的，不能改，
  //        但**值**通常可以按你的需要调。
  // [强制] DSH 官方校验器 `dsh-plugin-dev check` 会判 FAIL 的字段。
  //        不满足就过不了门禁，必须改对。
  // [约定] DSH 校验器只给 WARN。官方建议这么写，不写也能跑。
  // [自选] 本项目自己的取值，随便改，不影响框架行为。
  //
  // 校验规则的权威来源：dsh-plugin-guide/src/cli/commands/check.ts
  // 一条命令自查：node dsh-plugin-guide/dist/dsh-plugin-dev.js check --json
  // ==========================================================================

  // --------------------------------------------------------------------------
  // 基本信息
  // --------------------------------------------------------------------------
  // [固定] npm 必填。包名，发布到 npm 时的唯一标识。
  // 三处必须一致：这里、src/index.ts 的 export const name、cordis.patch.yml 的 name。
  "name": "dsh-plugin-craft",

  // [固定] npm 必填。语义化版本 主版本.次版本.修订号。
  // 规则：破坏性改动升主版本、新功能升次版本、修 bug 升修订号。
  "version": "0.3.4",

  // [固定] npm 标准，可选。显示在包列表和搜索结果里。
  // [自选] 这里说明了本插件的真实定位：交付的是「一个自定义 agent 预设」，
  //        而不是一个 UI —— 工坊本身是一段聊天对话。
  "description": "DSH Plugin Workshop — ships a custom agent preset (id: craft, label: 插件工坊) that pairs the workshop tools with a plugin-development persona so users can build DSH plugins through chat.",

  // [固定] npm 标准。声明包内 .js 按哪种模块系统解析。
  // [自选] 这里是 "module"（ESM），因为 tsdown 只出 ESM 产物。
  "type": "module",

  // --------------------------------------------------------------------------
  // 入口
  // --------------------------------------------------------------------------
  // [强制] DSH 必填。宿主加载插件时 import 的文件。
  // 硬性要求：必须指向**已经构建出来的**产物，不能指向 src/。
  // 校验器在你没先跑 build 时会 WARN「main entry not built yet」。
  "main": "lib/index.mjs",

  // [约定] TypeScript 标准。类型声明入口。
  // [自选] 指向 tsdown 产出的声明文件。里面保留的是 src/*.ts 的 JSDoc，
  //        所以源码里的注释是写给外部使用者看的，会直接出现在别人 IDE 里。
  "types": "lib/index.d.mts",

  // [固定] npm 标准。精确控制「哪些子路径可以 import」。
  // 加了 exports 之后，深层文件默认被封住，别人只能按这里声明的路径引。
  "exports": {
    // "." = 包根（import 'dsh-plugin-craft' 走这条）
    ".": {
      // types 必须排在 default 前面，TypeScript 才会优先取它
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    // 必须显式放行 package.json：
    // 加了 exports 之后它默认被封住，而有些工具（读版本号的检查器）需要能读到。
    "./package.json": "./package.json"
  },

  // --------------------------------------------------------------------------
  // 打包内容
  // --------------------------------------------------------------------------
  // [强制] DSH 必填。发布白名单：只有列在这里的才进 npm 包。
  // 校验器强制三件事，缺一报 FAIL：
  //   ① 必须包含 dsh.bundle.patch 指向的那个层文件
  //   ② 必须包含 main 入口（或包含它所在的目录）
  //   ③ 必须包含构建产物目录（lib 或 dist）
  // 好处：node_modules、测试、tsconfig 一律不进包，用户装到的体积很小。
  "files": [
    // 构建产物目录 —— 满足条件③
    "lib",
    // bundle 层声明 —— 满足条件①。宿主靠它才知道怎么组装这个插件
    "cordis.patch.yml",
    // 图标
    "icon.svg",
    // 多语言文案目录
    "locale",
    // 说明文档
    "README.md",
    // 许可证（Apache-2.0）
    "LICENSE"
  ],

  // --------------------------------------------------------------------------
  // scripts —— 可执行命令的快捷方式
  // --------------------------------------------------------------------------
  // [固定] npm 标准。格式是 "名字": "命令"，之后用 `pnpm 名字` 跑。
  "scripts": {
    // [自选] 构建
    "build": "tsdown",
    // [自选] 历史上 Client 端要分开构建，0.3.0 砍掉 Client 后两者指向同一件事。
    //        保留别名是为了不破坏别人的调用习惯。
    "build:host": "tsdown",
    // [自选] 只做类型检查不产出（tsc --noEmit）
    "typecheck": "tsc --noEmit",
    // [自选] 跑一次单测就退出（不是 watch）
    "test": "vitest run",
    // [固定] npm 生命周期钩子：「装完依赖之后、正式使用之前」自动执行。
    // 用途：从 git 装这个包时，宿主需要先构建才能拿到 lib/。
    // 注意：从 npm / tarball 装则不需要额外构建许可，这也是官方推荐的发版方式。
    // 如果你的包不需要构建（比如纯 JS、产物已入库），这个脚本可以去掉。
    "prepare": "npm run build"
  },

  // --------------------------------------------------------------------------
  // dependencies —— 运行时依赖
  // --------------------------------------------------------------------------
  // [固定] npm 标准。打包时会一并装给用户的包。
  "dependencies": {
    // [自选] 构建工具（rolldown 封装）
    "tsdown": "^0.22.14",
    // [自选] TypeScript 编译器。
    // 放 dependencies 而不是 devDependencies 的原因：从 git 装时会跑
    // prepare → build，构建过程需要 tsc 可用；放 devDeps 的话，
    // 在只装生产依赖的环境里这一步会失败。
    "typescript": "^5.9.3"
  },

  // ==========================================================================
  // 【小白向】dependencies / devDependencies / peerDependencies 到底是啥
  // ----------------------------------------------------------------------------
  // 先搞懂一个词：宿主（host）
  //
  // 「宿主」= 运行你这个插件的那个大程序，也就是 DSH（DeepSeek Harness）。
  // 打个比方：
  //     DSH          = 一座商场
  //     Cordis       = 商场的电路/插座标准
  //     你的插件      = 用这个标准做出来的一件电器
  // 电器要插进商场的插座才能通电 —— 也就是说，你的插件必须依赖 DSH 底下
  // 那套 Cordis 框架。这就是下面反复出现的「宿主框架」。
  //
  // 三个依赖字段，区别就一句话：谁装、装给谁、装几份
  //
  //   dependencies       随你的包一起装给用户。每人一份。
  //                      例：构建工具 tsdown。
  //
  //   devDependencies    只在「开发这个插件的人」电脑上装，用户拿到的是
  //                      已经构建好的 lib/index.mjs，根本不需要测试框架。
  //                      例：vitest、@types/node。
  //
  //   peerDependencies    「我不带你走，但你必须已经有了，而且版本得跟我对得上」
  //                      pnpm 不会重复装一份，只会检查你环境里有没有、版本合不合适。
  //                      例：@deepseek-ai/cordis、@deepseek-ai/schemastery。
  //
  // 为什么 cordis 这种一定要写 peerDependencies（而不是 dependencies）？
  //   因为宿主自己已经有一份 cordis 了。如果你写进 dependencies，
  //   pnpm 会在你的 node_modules 里再装一份**新的** cordis。
  //   结果就是「两份 cordis」：
  //       你的插件拿着新 cordis 的 ctx 去注册工具，
  //       宿主拿着老 cordis 的 ctx 去找工具 —— 两边互不相认，
  //       你注册的工具宿主永远看不见，表现为「工具明明写了却不出现」。
  //   写成 peerDependencies，pnpm 就不给你装第二份，全场只有一份 cordis。
  //
  // ==========================================================================
  // 【小白向】里面填的那些字符串是版本号吗？
  //
  // 是**版本范围**，不是某个具体版本。含义是「这些版本我都能用」。
  // 几种写法：
  //
  //   ^4.0.2          插入符号 = 兼容范围。实测：接受 4.0.2 ~ 4.99.99，
  //                    到 5.0.0 就拒绝。也就是「4.x 随便用，5.x 不行」。
  //
  //   ^22.19.0        同理：22.19.0 ~ 22.x 都行。实测 22.18.0 拒绝、22.20.1 接受。
  //
  //   >=0.1.2-rc.1 <0.2.0
  //                    两段用空格连起来 = 「大于等于 0.1.2-rc.1，
  //                    同时小于 0.2.0」。
  //
  //   A || B          双竖线 = 或者。满足其中任意一段就算通过。
  //
  // 所以 dsh-tools 那串
  //   >=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || ...
  // 逐字读就是：满足下面任意一段就算合格
  //   「>= 0.1.2-rc.1 且 < 0.2.0」
  //   「>= 0.1.5-alpha.1 且 < 0.2.0」
  //   「>= 0.1.6-0 且 < 0.2.0」
  //   「>= 0.1.7-0 且 < 0.2.0」
  //
  // 实测它到底接受哪些版本：
  //   0.1.1        拒绝  （太老）
  //   0.1.2-rc.1   接受  （正好卡在下限）
  //   0.1.2        接受
  //   0.1.5-alpha.1 接受
  //   0.1.6-0      接受
  //   0.1.7-0      接受
  //   0.1.7-rc.2   接受
  //   0.1.9        接受
  //   0.2.0        接受  （由 >=0.2.0-0 <0.3.0 那两段覆盖）
  //   0.2.1-0      接受
  //   1.0.0        拒绝
  // 归纳起来：0.1.x 段等价于「>= 0.1.2-rc.1 且 < 0.2.0」，
  //           0.2.x 段等价于「>= 0.2.0-0 且 < 0.3.0」。
  //
  // 那为什么不简化？两个原因：
  //   1. semver 的默认规矩是**预发布版不算数**。实测如果只写 ^0.1.2，
  //      那么 0.1.7-rc.2 会被**拒绝** —— 因为带 -rc / -alpha 的是预发布版。
  //      而官方恰恰大量发布 rc/alpha 版（比如你环境里装的就是 0.1.7-rc.2），
  //      所以必须显式写出带预发布号的下限，才能把它们纳进来。
  //      还要注意 semver 的预发布规则：预发布版只有当区间里存在**同一个
  //      [主.次.修] 元组**的带预发布比较器时才算满足。所以 0.1.6-0 / 0.1.7-0
  //      这些不同元组的预发布版，光靠「>=0.1.2-rc.1 <0.2.0」一段是匹配不上的
  //      —— 每个元组都得单独一段。
  //   2. 后面几段相当于一份「白名单记录」：哪几个预发布版是官方验证过的。
  //      这段范围是**写死在 dsh-plugin-dev 的 check 里**的，自己不能改，照抄即可。
  //
  // ⚠️ 0.2 那一段是**承重**的，不是冗余：dsh 在安装时会校验 peer 范围，
  //    范围一旦停在 0.1.x，装在 0.2.x 宿主上的插件会被直接拒收
  //    （installation rejected: ... is incompatible with dsh 0.2.1-alpha.1）。
  //
  // 「每个版本功能不一样吗？」—— 是的，版本不同功能确实不同。
  // 但版本范围存在的意义就是：我只用了「从 0.1.2 到 0.3.0 之间一直没变过」
  // 的那些稳定接口，所以中间任何小版本我都能用。
  // 一旦到了 0.3.0 就是大版本更迭，接口可能变了，所以卡在 <0.3.0。
  // ==========================================================================

  // --------------------------------------------------------------------------
  // devDependencies —— 开发期依赖
  // --------------------------------------------------------------------------
  // [固定] npm 标准。只有开发这个插件时才需要，不装给最终用户。
  "devDependencies": {
    // [强制] 宿主框架。版本范围被校验器写死，见下方 peerDependencies 的说明。
    "@deepseek-ai/cordis": "^4.0.2",
    // [强制] 工具定义库。范围是硬编码的，抄 peerDependencies 那行。
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    // [强制] 配置校验库
    "@deepseek-ai/schemastery": "^3.18.2",
    // [自选] Node 内置模块的类型声明
    "@types/node": "^22.20.1",
    // [自选] 测试框架
    "vitest": "^3.2.7"
  },

  // --------------------------------------------------------------------------
  // peerDependencies —— 对等依赖
  // --------------------------------------------------------------------------
  // [强制] DSH 必填（只要你 import 了 @deepseek-ai/* 的东西）。
  //
  // 为什么必须是 peer 而不是 dependency：
  //   1. 避免装出第二份 cordis。两份 cordis 会导致上下文互不相认，工具全部失灵。
  //   2. 版本由宿主统一控制，不会和宿主冲突。
  //
  // 校验器会扫你的源码，把所有 import 进来的 @deepseek-ai/* 找出来，
  // 然后逐个比对：**缺一个报 FAIL，版本范围写得不一样也报 FAIL**。
  // 范围是写死在 check.ts 里的，不能自己发挥：
  //   @deepseek-ai/cordis       → ^4.0.2
  //   @deepseek-ai/schemastery  → ^3.18.2
  //   @deepseek-ai/dsh-*        → >=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0
  //                                || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0
  "peerDependencies": {
    // [强制] 宿主框架
    "@deepseek-ai/cordis": "^4.0.2",
    // [强制] 范围必须和上面 devDependencies 里那一行一模一样，
    //        避免「开发用一套、运行用另一套」
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    // [强制] 配置校验库
    "@deepseek-ai/schemastery": "^3.18.2"
  },

  // --------------------------------------------------------------------------
  // dsh —— 宿主专有的字段
  // --------------------------------------------------------------------------
  // [强制] DSH 专有。不是 npm 标准字段，别的包管理器会直接忽略它。
  // 整个 DSH 生态靠这一块区分「bundle 插件」和「纯 cordis 插件」。
  "dsh": {
    // bundle 声明：告诉宿主「这是一个 bundle 类型插件，
    // 对应的层文件是 ./cordis.patch.yml」。
    // 不写这一块 → 只会被当成普通依赖装上，宿主不会激活任何层（装的时候会有警告）。
    "bundle": {
      // [强制] 层文件路径。指向的文件必须真实存在，否则报 FAIL。
      "patch": "./cordis.patch.yml"
    },
    // 清单格式版本号。宿主用它判断能不能读懂这份 package.json。
    "manifestVersion": 1
  },

  // --------------------------------------------------------------------------
  // 环境与元信息
  // --------------------------------------------------------------------------
  // [强制] DSH 必填。支持的 Node 版本范围。
  // 校验器会检查这个字符串里**必须同时出现 22 和 24**，
  // 官方推荐写法就是 "^22.19.0 || >=24.0.0"。
  // 不写 → FAIL；只写一个版本 → FAIL。
  "engines": {
    // [强制] 22.19.0 及以上的 22.x，或者 24 及以上。中间的 23.x 不在支持范围内。
    "node": "^22.19.0 || >=24.0.0"
  },

  // [约定] 声明用哪个包管理器、哪个版本。
  // 校验器只给 WARN。官方家族标准值是 pnpm@11.7.0，
  // 写别的只是 warn，写对了 status 是 pass。目的是让安装可复现。
  "packageManager": "pnpm@11.7.0",

  // [固定] npm 标准。许可证。Apache-2.0 允许商用和闭源衍生，只要求保留声明。
  "license": "Apache-2.0"
}
